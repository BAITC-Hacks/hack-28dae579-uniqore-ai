# Скопируйте в .env и заполните, если хотите включить LLM-путь.
# Без этих переменных скрипт работает на правилах — это штатный режим.
# Файл .env в репозиторий не коммитится (см. .gitignore).

# Ключ OpenRouter: https://openrouter.ai/keys
# Принимаются также OPENROUTER_API_KEY и OPENAI_API_KEY.
LLM_API_KEY=

# Базовый URL OpenAI-совместимого API.
# OpenRouter (по умолчанию): https://openrouter.ai/api/v1
# OpenAI:                    https://api.openai.com/v1
# NVIDIA NIM:                https://integrate.api.nvidia.com/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Имя модели у выбранного провайдера.
# Каталог OpenRouter: https://openrouter.ai/models
# Примеры: openai/gpt-4o-mini, anthropic/claude-3.5-haiku,
#          meta-llama/llama-3.3-70b-instruct
LLM_MODEL=openai/gpt-4o-mini

# Таймаут одного вызова, секунды (по умолчанию 20).
LLM_TIMEOUT=20
